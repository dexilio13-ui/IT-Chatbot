# === Backend (Python/FastAPI) ===

# PostgreSQL (lokalni)
# Default EDB installer port je 5433, standardni PostgreSQL port je 5432
DATABASE_URL=postgresql://postgres:tvoja-lozinka@localhost:5433/postgres

# Groq API kljuc za LLM (llama-3.3-70b-versatile)
# Registruj se na: https://console.groq.com
GROQ_API_KEY=ovde-upisi-svoj-groq-api-kljuc

# JWT Secret Key (generisi nasumicni string: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=ovde-upisi-svoj-secret-key

# Qdrant Cloud
QDRANT_URL=https://10122a59-df92-4dc4-ada8-b30ef4552b37.europe-west3-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=it_support_kb

# === Frontend (React/Vite) ===

# URL FastAPI backend-a (podrazumevano localhost:8000)
VITE_API_URL=http://localhost:8000
