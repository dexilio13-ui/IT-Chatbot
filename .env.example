# === Backend (Python/FastAPI) ===

# PostgreSQL (lokalni)
# Default EDB installer port je 5433, standardni PostgreSQL port je 5432
DATABASE_URL=postgresql://postgres:tvoja-lozinka@localhost:5433/postgres

# OpenAI API kljuc za LLM (gpt-4o-mini) i Embedding (text-embedding-3-small)
# Registruj se na: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-ovde-upisi-svoj-openai-api-kljuc

# LlamaCloud API kljuc za LlamaParse (napredno parsiranje PDF/Word dokumenta)
# Registruj se na: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-ovde-upisi-svoj-llamacloud-api-kljuc

# JWT Secret Key (generisi nasumicni string: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=ovde-upisi-svoj-secret-key

# Qdrant Cloud (vektor_size=1536 za text-embedding-3-small)
QDRANT_URL=https://tvoj-instance.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=it_support_kb

# === Frontend (React/Vite) ===

# URL FastAPI backend-a (podrazumevano localhost:8000)
VITE_API_URL=http://localhost:8000
