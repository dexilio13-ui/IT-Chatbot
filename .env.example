# === Backend (Python/FastAPI) ===

# Groq API kljuc za LLM (llama-3.3-70b-versatile)
# Registruj se na: https://console.groq.com
GROQ_API_KEY=ovde-upisi-svoj-groq-api-kljuc

# JWT Secret Key (generisi nasumicni string: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=ovde-upisi-svoj-secret-key

# === Frontend (React/Vite) ===

# URL FastAPI backend-a (podrazumevano localhost:8000)
# VITE_API_URL=http://localhost:8000
